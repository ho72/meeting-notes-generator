# STT runs locally; the model is downloaded on first use.
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ko
# Zero = automatic estimate. Labels are approximate, not speaker identities.
DIARIZATION_NUM_SPEAKERS=0
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=8
# Public defaults contain no personal meeting data or credentials.
MEETING_DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=500
MAX_PENDING_JOBS=8
JOB_TTL_SECONDS=1800
# Optional. Clicking AI generation sends the edited transcript to Google.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
# Same-origin UI needs no CORS override. List explicit origins only if required.
CORS_ORIGINS=
